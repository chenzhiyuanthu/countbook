{
  "$comment": "Single source of truth for every colour, metric and duration in 据实. scripts/gen-tokens.mjs generates web/src/styles/tokens.css and ios/Countbook/Design/Tokens.swift from this file. A hex value must never be written anywhere else.",
  "meta": {
    "name": "据实 · Instrument of Record",
    "version": "1.0.0"
  },
  "color": {
    "$doc": "Grounds and ink are neutral warm. Colour exists in exactly three roles and nowhere else: over (live negative allowance), held (cooling / pending), spared (abandoned / saved). Regret is rendered in `lead`, a dead grey used for nothing else, so the live red never loses its urgency.",
    "paper":         { "light": "#F7F6F3", "dark": "#121211", "use": "app ground" },
    "surface":       { "light": "#FFFFFF", "dark": "#1A1A18", "use": "cards, sheets, rows" },
    "surfaceSunken": { "light": "#F1EFEA", "dark": "#0E0E0D", "use": "keypad, inset wells, table headers" },
    "ink900":        { "light": "#111110", "dark": "#F2F0EA", "use": "hero + section figures, primary text" },
    "ink700":        { "light": "#35342F", "dark": "#C9C6BE", "use": "body text, row figures" },
    "ink500":        { "light": "#6E6C64", "dark": "#8C897F", "use": "labels, secondary rows" },
    "ink300":        { "light": "#A5A29A", "dark": "#605D56", "use": "units, 分, timestamps, placeholders" },
    "rule":          { "light": "#E2DFD8", "dark": "#2B2A27", "use": "hairlines" },
    "ruleStrong":    { "light": "#C9C5BB", "dark": "#3D3B36", "use": "section rules, focused card borders" },
    "figOver":       { "light": "#A32A22", "dark": "#E0655A", "use": "ONLY: negative 今日可用, category above standard" },
    "figHeld":       { "light": "#8A6A1F", "dark": "#D2A64A", "use": "ONLY: cooling period, pending sync" },
    "figSpared":     { "light": "#2E5D4B", "dark": "#6FA98A", "use": "ONLY: 已放弃 / 已省 totals" },
    "figRegret":     { "light": "#514E47", "dark": "#9A968C", "use": "ONLY: 后悔金额 — dead lead, never urgent" },
    "scrim":         { "light": "rgba(17,17,16,0.28)", "dark": "rgba(0,0,0,0.48)", "use": "modal scrim, no blur" },
    "accentInk":     { "light": "#111110", "dark": "#F2F0EA", "use": "primary button fill" },
    "accentOn":      { "light": "#FFFFFF", "dark": "#121211", "use": "text on primary button" }
  },
  "space": { "$doc": "4px base.", "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
  "radius": {
    "$doc": "Web circular corners read heavier than iOS continuous corners at the same number, so each role carries two values chosen to look identical rather than to measure identical.",
    "field": { "web": 7, "ios": 8 },
    "card":  { "web": 9, "ios": 10 },
    "sheet": { "web": 14, "ios": 16 },
    "pill":  { "web": 999, "ios": 999 }
  },
  "type": {
    "$doc": "px values are the reference at the default text size; web expresses them in rem against a 16px root so browser zoom and iOS Dynamic Type both scale the whole system.",
    "hero":    { "size": 64, "weight": 300, "tracking": -0.02, "leading": 1.02 },
    "screen":  { "size": 44, "weight": 300, "tracking": -0.02, "leading": 1.06 },
    "section": { "size": 34, "weight": 400, "tracking": -0.015, "leading": 1.12 },
    "row":     { "size": 17, "weight": 500, "tracking": 0, "leading": 1.3 },
    "body":    { "size": 15, "weight": 400, "tracking": 0, "leading": 1.53 },
    "label":   { "size": 11, "weight": 600, "tracking": 0.14, "leading": 1.4 },
    "labelCJK":{ "size": 11, "weight": 600, "tracking": 0.08, "leading": 1.4 },
    "micro":   { "size": 10, "weight": 500, "tracking": 0.06, "leading": 1.4 }
  },
  "motion": {
    "$doc": "One curve, no springs, no overshoot.",
    "ease": [0.32, 0.08, 0.24, 1],
    "figureSettle": 220,
    "figureStagger": 18,
    "sheetPresent": 280,
    "sheetDismiss": 200,
    "stampSlide": 180,
    "rowPrint": 240,
    "rowFade": 120,
    "verdictSwipe": 260,
    "scrimFade": 200
  },
  "elevation": {
    "$doc": "Exactly one shadow exists, on the capture sheet and modals. Everywhere else depth is value and rule weight.",
    "sheet": {
      "web": "0 1px 2px rgba(17,17,16,.04), 0 12px 32px -8px rgba(17,17,16,.16)",
      "ios": [
        { "opacity": 0.04, "radius": 1,  "y": 1 },
        { "opacity": 0.16, "radius": 16, "y": 12 }
      ]
    }
  },
  "layout": {
    "contentMax": 720,
    "gutter": 20,
    "hitTarget": 44,
    "rowPadY": 14,
    "hairline": 1
  },
  "rule": {
    "$doc": "Product constants that the UI prints, so they live beside the design values rather than being buried in logic.",
    "leakCeilingFen": 3000,
    "coolingFloorFen": 30000,
    "coolingDaysMin": 1,
    "coolingDaysMax": 14,
    "coolingFenPerDay": 10000,
    "reckoningWeekday": 0,
    "reckoningHour": 20,
    "reckoningMaxCards": 12,
    "deferralLimit": 3,
    "minJudgedForRegretRate": 30,
    "holdToSaveMs": 3000
  }
}
